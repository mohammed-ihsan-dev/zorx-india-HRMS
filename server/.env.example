## ZORX INDIA — Office Management System — Server Environment Variables
## Copy this file to .env and fill in real values. NEVER commit .env.

NODE_ENV=development
PORT=5001

# MongoDB Atlas
MONGODB_DB=zorx-ms
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.un0pupo.mongodb.net/?appName=Cluster0

# JWT
JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=8h

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Office location — PROVISIONAL default values, editable later from Admin Settings.
OFFICE_LATITUDE=10.991401
OFFICE_LONGITUDE=76.442772
OFFICE_ATTENDANCE_RADIUS=200

# Working hours
TIMEZONE=Asia/Kolkata
WORKING_START_TIME=09:30
WORKING_END_TIME=18:00
BREAK_DURATION_MINUTES=60
LATE_THRESHOLD_MINUTES=15
HALF_DAY_THRESHOLD_MINUTES=240

# Non-persisted virtual test employee account — logs in and uses the normal
# employee UI, but creates no User/Employee document and no business data
# (attendance/leave/content-calendar writes are simulated, never saved).
# Defaults to disabled; set TEST_USER_ENABLED=false (or remove these lines)
# to turn it off immediately. In production, ALLOW_VIRTUAL_TEST_USER=true is
# ALSO required, as a second explicit opt-in.
TEST_USER_ENABLED=false
TEST_USER_EMAIL=user@gmail.com
TEST_USER_PASSWORD=12345678
ALLOW_VIRTUAL_TEST_USER=false

# Company Wi-Fi attendance (Admin → Office Settings → Attendance Verification).
# Server-side only; never exposed to the frontend. Comma-separated PUBLIC IPs
# and/or CIDR ranges of the office internet connection. Private/LAN addresses
# (e.g. 192.168.x.x) are rejected. Leave unset and Wi-Fi mode cannot be enabled.
# Only use a STATIC public IP confirmed by the ISP.
# ATTENDANCE_WIFI_ALLOWED_IPS=43.229.89.156
#
# Express "trust proxy" — decides which X-Forwarded-For entry is the client IP.
# Default 1. Verify with Office Settings → "Check This Device's Network" from
# the office before enabling Wi-Fi mode; adjust if the detected IP is wrong.
# TRUST_PROXY=1

# Password reset emails (Login → "Forgot password?").
# Preferred: Resend HTTPS API (works on Render free, which blocks SMTP ports).
# Create an API key with "Sending access" at resend.com and verify your domain;
# MAIL_FROM must use that verified domain. When RESEND_API_KEY is set it is used
# instead of SMTP. Never commit the real key.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# MAIL_FROM="ZORX INDIA <noreply@zorxindia.online>"
#
# Alternative: SMTP (only where outbound SMTP is allowed), e.g. Gmail with an
# App Password. If no provider is set, reset emails are not sent (a warning is logged).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-sender@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM="ZORX INDIA HRMS <your-sender@gmail.com>"  (SMTP: same mailbox as SMTP_USER)
#
# Public URL of the frontend, used in the reset link.
# APP_URL=https://zorxindia.online

## ZORX INDIA — Office Management System — Server Environment Variables
## Copy this file to .env and fill in real values. NEVER commit .env.

NODE_ENV=development
PORT=5001

# MongoDB Atlas
MONGODB_DB=zorx-ms
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.un0pupo.mongodb.net/?appName=Cluster0

# JWT
JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=8h

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Office location — PROVISIONAL default values, editable later from Admin Settings.
OFFICE_LATITUDE=10.991401
OFFICE_LONGITUDE=76.442772
OFFICE_ATTENDANCE_RADIUS=200

# Working hours
TIMEZONE=Asia/Kolkata
WORKING_START_TIME=09:30
WORKING_END_TIME=18:00
BREAK_DURATION_MINUTES=60
LATE_THRESHOLD_MINUTES=15
HALF_DAY_THRESHOLD_MINUTES=240

# Non-persisted virtual test employee account — logs in and uses the normal
# employee UI, but creates no User/Employee document and no business data
# (attendance/leave/content-calendar writes are simulated, never saved).
# Defaults to disabled; set TEST_USER_ENABLED=false (or remove these lines)
# to turn it off immediately. In production, ALLOW_VIRTUAL_TEST_USER=true is
# ALSO required, as a second explicit opt-in.
TEST_USER_ENABLED=false
TEST_USER_EMAIL=user@gmail.com
TEST_USER_PASSWORD=12345678
ALLOW_VIRTUAL_TEST_USER=false
